{
  "name": "lavatiles",
  "compatibility_date": "2026-09-17",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "CATALOGUE_PDFS",
      "bucket_name": "lavatiles-catalogue-pdfs"
    }
  ]
}
